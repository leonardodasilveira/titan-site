# Copiar para .env e preencher. O .env NUNCA é commitado.

# ── Banco ────────────────────────────────────────────────────────────────
# Docker local (docker-compose) ou Postgres gerenciado (Neon/Supabase).
# Ver TIT-7 — Docker ainda não está configurado nesta máquina.
DATABASE_URL="postgresql://titan:titan@localhost:5432/titan?schema=public"

# ── Blizzard / Battle.net ────────────────────────────────────────────────
# Criar cliente em https://develop.battle.net/access/clients — ver TIT-8
BLIZZARD_CLIENT_ID=""
BLIZZARD_CLIENT_SECRET=""
# Região da guilda: us | eu | kr | tw | cn. Os endpoints são por região.
BLIZZARD_REGION="us"

# Guilda a verificar no roster (nome e realm como aparecem no jogo).
GUILD_NAME=""
GUILD_REALM=""

# ── Sessão ───────────────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ── Discord ──────────────────────────────────────────────────────────────
# Webhook do canal privado dos oficiais — ver TIT-17
DISCORD_WEBHOOK_URL=""

# ── URLs ─────────────────────────────────────────────────────────────────
API_PORT="3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
