{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // O scaffold do Nest vem com strict desligado e noImplicitAny: false.
    // Apertado de propósito — TypeScript rigoroso é requisito do projeto.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  // prisma.config.ts é carregado pelo CLI do Prisma, não pelo app. Ele usa
  // `import.meta`, que não existe na saída CommonJS do Nest — se entrar no
  // build, o tsc falha com TS1470.
  "exclude": ["node_modules", "dist", "prisma.config.ts"]
}
